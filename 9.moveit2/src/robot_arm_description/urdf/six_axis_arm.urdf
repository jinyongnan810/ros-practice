<?xml version="1.0"?>
<!-- Dimensions in metres, mass in kilograms, angles in radians.
     Joint axes: base yaw, shoulder pitch, elbow pitch, wrist roll,
     wrist pitch, tool roll. Zero pose extends along +X above the base. -->
<robot name="six_axis_arm">
  <material name="dark"><color rgba="0.18 0.20 0.24 1"/></material>
  <material name="blue"><color rgba="0.12 0.40 0.80 1"/></material>
  <material name="silver"><color rgba="0.75 0.78 0.82 1"/></material>

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/><child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/><mass value="4"/>
      <inertia ixx="0.0165333333" ixy="0" ixz="0" iyy="0.0165333333" iyz="0" izz="0.0288"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 0 1"/>
    <limit lower="-3.141593" upper="3.141593" effort="100" velocity="1.5"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><cylinder radius="0.075" length="0.20"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10"/>
      <geometry><cylinder radius="0.075" length="0.20"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.10"/><mass value="2"/>
      <inertia ixx="0.0094791667" ixy="0" ixz="0" iyy="0.0094791667" iyz="0" izz="0.005625"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0 0.20"/><axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="100" velocity="1.5"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.15 0 0"/>
      <geometry><box size="0.30 0.08 0.08"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.15 0 0"/>
      <geometry><box size="0.30 0.08 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0"/><mass value="2"/>
      <inertia ixx="0.0021333333" ixy="0" ixz="0" iyy="0.0160666667" iyz="0" izz="0.0160666667"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0.30 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.356194" upper="2.356194" effort="60" velocity="1.8"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <link name="forearm_link">
    <visual>
      <origin xyz="0.13 0 0"/>
      <geometry><box size="0.26 0.065 0.065"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.13 0 0"/>
      <geometry><box size="0.26 0.065 0.065"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.13 0 0"/><mass value="1.5"/>
      <inertia ixx="0.00105625" ixy="0" ixz="0" iyy="0.008978125" iyz="0" izz="0.008978125"/>
    </inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="forearm_link"/><child link="wrist_1_link"/>
    <origin xyz="0.26 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.141593" upper="3.141593" effort="20" velocity="2.5"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="wrist_1_link">
    <visual>
      <origin xyz="0.04 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.045" length="0.08"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.045" length="0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0 0"/><mass value="0.5"/>
      <inertia ixx="0.00050625" ixy="0" ixz="0" iyy="0.0005197917" iyz="0" izz="0.0005197917"/>
    </inertial>
  </link>

  <joint name="joint_5" type="revolute">
    <parent link="wrist_1_link"/><child link="wrist_2_link"/>
    <origin xyz="0.08 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="20" velocity="2.5"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="wrist_2_link">
    <visual>
      <origin xyz="0.035 0 0"/>
      <geometry><box size="0.07 0.055 0.055"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.035 0 0"/>
      <geometry><box size="0.07 0.055 0.055"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.035 0 0"/><mass value="0.4"/>
      <inertia ixx="0.0002016667" ixy="0" ixz="0" iyy="0.0002641667" iyz="0" izz="0.0002641667"/>
    </inertial>
  </link>

  <joint name="joint_6" type="revolute">
    <parent link="wrist_2_link"/><child link="flange_link"/>
    <origin xyz="0.07 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.141593" upper="3.141593" effort="10" velocity="3.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="flange_link">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.02 0 0"/><mass value="0.2"/>
      <inertia ixx="0.0001225" ixy="0" ixz="0" iyy="0.0000879167" iyz="0" izz="0.0000879167"/>
    </inertial>
  </link>

  <!-- Tool frame at the flange face, with +Z pointing out along the tool. -->
  <joint name="flange_to_tool" type="fixed">
    <parent link="flange_link"/><child link="tool0"/>
    <origin xyz="0.04 0 0" rpy="0 1.57079632679 0"/>
  </joint>
  <link name="tool0"/>
</robot>
