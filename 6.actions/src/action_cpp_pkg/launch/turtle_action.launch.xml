<launch>
  <arg
    name="launch_client"
    default="false"
    description="Whether to launch the action client node alongside turtlesim and server"
  />

  <node pkg="turtlesim" exec="turtlesim_node" name="turtlesim" />
  <node pkg="action_cpp_pkg" exec="turtle_action_server" name="turtle_action_server" output="screen" />
  <node pkg="action_cpp_pkg" exec="turtle_action_client" name="turtle_action_client" output="screen" if="$(var launch_client)" />
</launch>
