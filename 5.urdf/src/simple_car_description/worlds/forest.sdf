<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="forest_world">
    <!-- ================= Physics Settings ================= -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ================= Gazebo Sim Plugins ================= -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <!-- ================= Environment & Sky ================= -->
    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.7 0.85 0.95 1.0</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>10</speed>
        </clouds>
      </sky>
    </scene>

    <!-- ================= Sunlight ================= -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.88 0.8 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- ================= Grassy Ground Plane ================= -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.35 0.12 1.0</ambient>
            <diffuse>0.22 0.45 0.16 1.0</diffuse>
            <specular>0.05 0.08 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= Gazebo Fuel Forest Trees ================= -->
    <!-- Pine Trees (app.gazebosim.org / OpenRobotics / Pine Tree) -->
    <include>
      <name>pine_tree_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>6.5 4.0 0 0 0 0.3</pose>
    </include>

    <include>
      <name>pine_tree_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>8.0 -3.5 0 0 0 -0.8</pose>
    </include>

    <include>
      <name>pine_tree_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>-6.0 5.5 0 0 0 1.2</pose>
    </include>

    <include>
      <name>pine_tree_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>-7.5 -4.0 0 0 0 -0.4</pose>
    </include>

    <include>
      <name>pine_tree_5</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>12.0 8.0 0 0 0 0.9</pose>
    </include>

    <include>
      <name>pine_tree_6</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>14.0 -7.0 0 0 0 -1.5</pose>
    </include>

    <include>
      <name>pine_tree_7</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>-13.0 9.0 0 0 0 0.6</pose>
    </include>

    <include>
      <name>pine_tree_8</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>-11.0 -10.0 0 0 0 -2.1</pose>
    </include>

    <include>
      <name>pine_tree_9</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>0.0 12.0 0 0 0 1.8</pose>
    </include>

    <include>
      <name>pine_tree_10</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>0.0 -12.0 0 0 0 -0.5</pose>
    </include>

    <!-- Oak Trees (app.gazebosim.org / OpenRobotics / Oak tree) -->
    <include>
      <name>oak_tree_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>4.5 -8.0 0 0 0 0.5</pose>
    </include>

    <include>
      <name>oak_tree_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>-5.0 -8.5 0 0 0 -1.1</pose>
    </include>

    <include>
      <name>oak_tree_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>5.0 9.0 0 0 0 2.0</pose>
    </include>

    <include>
      <name>oak_tree_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>-8.0 1.0 0 0 0 -0.7</pose>
    </include>

    <include>
      <name>oak_tree_5</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>9.5 0.5 0 0 0 1.4</pose>
    </include>

    <include>
      <name>oak_tree_6</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>-15.0 -3.0 0 0 0 0.8</pose>
    </include>

    <include>
      <name>oak_tree_7</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>16.0 2.0 0 0 0 -1.3</pose>
    </include>

  </world>
</sdf>
