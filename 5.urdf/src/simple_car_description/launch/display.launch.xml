<launch>
    <arg name="model" default="$(find-pkg-share simple_car_description)/urdf/simple_car.urdf" />
    <arg name="rvizconfig" default="$(find-pkg-share simple_car_description)/rviz/display.rviz" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'xacro $(var model)')" type="str" />
    </node>

    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" output="screen" />
    <node pkg="rviz2" exec="rviz2" args="-d $(var rvizconfig)" output="screen" />
</launch>