<launch>
    <!-- Set Gazebo resource path to resolve model://simple_car_description/... -->
    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share simple_car_description)/..:$(env GZ_SIM_RESOURCE_PATH '')" />
    <set_env name="GZ_RESOURCE_PATH" value="$(find-pkg-share simple_car_description)/..:$(env GZ_RESOURCE_PATH '')" />

    <arg name="model" default="$(find-pkg-share simple_car_description)/urdf/simple_car.urdf.xacro" />
    <arg name="world" default="empty.sdf" />
    <arg name="use_sim_time" default="true" />
    <arg name="rviz" default="false" description="Whether to start RViz alongside Gazebo." />
    <arg name="rvizconfig" default="$(find-pkg-share simple_car_description)/rviz/display.rviz" description="Path to RViz config file." />
    <arg name="bridge_config" default="$(find-pkg-share simple_car_description)/config/gazebo_bridge.yaml" description="Path to the ROS-Gazebo bridge configuration YAML file." />

    <!-- Robot State Publisher -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'xacro $(var model)')" type="str" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

    <!-- Start Gazebo Sim -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var world) -r" />
    </include>

    <!-- Spawn Robot Model in Gazebo -->
    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description -name simple_car -z 0.1" output="screen" />

    <!-- ROS-Gz Bridge configured via YAML file -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
        <param name="config_file" value="$(var bridge_config)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

    <!-- Optional RViz2 -->
    <node pkg="rviz2" exec="rviz2" args="-d $(var rvizconfig)" if="$(var rviz)" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>
</launch>
