<?xml version="1.0"?>
<launch>
    <set_env name="GZ_SIM_RESOURCE_PATH"
        value="$(find-pkg-share robot_description)/..:$(env GZ_SIM_RESOURCE_PATH '')" />

    <arg name="model" default="$(find-pkg-share robot_description)/urdf/simple_car.urdf.xacro" />
    <arg name="world" default="$(find-pkg-share robot_description)/worlds/empty.sdf"
        description="Gazebo world; forest.sdf from 5.urdf is also installed" />
    <arg name="controller_config" default="$(find-pkg-share robot_bringup)/config/robot_controllers.yaml" />
    <arg name="bridge_config" default="$(find-pkg-share robot_bringup)/config/gazebo_bridge.yaml" />
    <arg name="x" default="0.0" />
    <arg name="y" default="0.0" />
    <arg name="z" default="0.1" />
    <arg name="use_rviz" default="false" />
    <arg name="rvizconfig" default="$(find-pkg-share robot_description)/rviz/display.rviz" />
    <arg name="use_position_command_gui" default="false" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description"
            value="$(command 'xacro $(var model) use_gazebo:=true controller_config:=$(var controller_config)')"
            type="str" />
        <param name="use_sim_time" value="true" />
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r $(var world)" />
    </include>

    <node pkg="ros_gz_sim" exec="create"
        args="-topic robot_description -name simple_car -x $(var x) -y $(var y) -z $(var z)"
        output="screen" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
        <param name="config_file" value="$(var bridge_config)" />
        <param name="use_sim_time" value="true" />
    </node>

    <!-- Gazebo's plugin starts the manager. The spawner waits for its services. -->
    <node pkg="controller_manager" exec="spawner"
        args="joint_state_broadcaster diff_drive_controller wheel_joint_controller arm_controller --controller-manager /controller_manager --controller-manager-timeout 120"
        output="screen" />

    <node pkg="robot_bringup" exec="position_command_gui.py"
        if="$(var use_position_command_gui)" output="screen">
        <param name="robot_description"
            value="$(command 'xacro $(var model) use_gazebo:=true controller_config:=$(var controller_config)')"
            type="str" />
        <param name="use_sim_time" value="true" />
    </node>

    <node pkg="rviz2" exec="rviz2" args="-d $(var rvizconfig)" if="$(var use_rviz)" output="screen">
        <param name="use_sim_time" value="true" />
    </node>
</launch>
