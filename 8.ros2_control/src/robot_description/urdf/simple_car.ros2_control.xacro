<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <ros2_control name="simple_car" type="system">
        <hardware>
            <!-- run the mock hardware interface -->
            <plugin>mock_components/GenericSystem</plugin>
            <param name="calculate_dynamics">true</param>
            <!-- use the hardware interface plugin -->
            <!-- <plugin>robot_hardware/BaseLinkHardwareInterface</plugin> -->
            <!-- <param name="port_name">/dev/ttyUSB0</param>
            <param name="front_left_wheel_id">10</param>
            <param name="front_right_wheel_id">11</param>
            <param name="rear_left_wheel_id">12</param>
            <param name="rear_right_wheel_id">13</param> -->
        </hardware>

        <!-- Drive Wheels -->
        <joint name="front_left_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="front_right_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="rear_left_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="rear_right_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <!-- Rotating Platform Joint -->
        <joint name="wheel_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <!-- Robotic Arm Joints -->
        <joint name="arm_joint_1">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="arm_joint_2">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>
</robot>